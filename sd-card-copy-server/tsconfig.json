{
    "compilerOptions": {
        "module": "nodenext",
        "isolatedModules": true,
        "declaration": false,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2023",
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "../dist/server",
        "types": ["node", "vitest/globals"],
        "incremental": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true
    },
    "include": ["src"]
}
